# 复制为 .env 后按需修改；不建 .env 也能直接跑（下面就是默认值）

# ---------- 数据库实例 ----------
POSTGRES_USER=roomdesk
POSTGRES_PASSWORD=roomdesk
DB_NAME=roomdesk

# ---------- 三个角色（bootstrap 时创建） ----------
MIGRATOR_USER=roomdesk_migrator
MIGRATOR_PASSWORD=migrator_pw
APP_USER=roomdesk_app
APP_PASSWORD=app_pw
READER_USER=roomdesk_reader
READER_PASSWORD=reader_pw

# ---------- pgbouncer 管理控制台 ----------
PGBOUNCER_ADMIN_USER=pgb_admin
PGBOUNCER_ADMIN_PASSWORD=pgb_admin_pw

# ---------- 应用 ----------
DB_POOL_MIN=1
DB_POOL_MAX=10
ADMIN_TOKEN=dev-admin-token
REFRESH_INTERVAL=15

# ---------- 端口（避开本机已有的 5432 / 8000） ----------
DB_PORT=55432
API_PORT=8000
ADMINER_PORT=8080

# ---------- 构建 ----------
# 基础镜像（可钉小版本，例如 python:3.12.7-slim）
PYTHON_IMAGE=python:3.12-slim
# pip 源：国内网络换成镜像站，冷构建会快很多
# （本机实测默认源冷构建 api 镜像约 5 分钟，worker 约 2 分钟；依赖有缓存后重建 1 秒）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- 其他 ----------
SEED=1
# 定时备份：间隔秒数、保留最近几份（脚本会自动轮转 + 校验）
BACKUP_INTERVAL=3600
BACKUP_KEEP=14
TZ=Asia/Shanghai
